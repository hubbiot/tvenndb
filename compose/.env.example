# Copy to .env next to the compose.yaml you run.

# Password of the first administrator, user "admin" (at least 12 characters).
TVENNDB_ADMIN_PASSWORD=

# Cluster only: shared by every shard and gateway; use a long random value,
# for example: openssl rand -hex 32
TVENNDB_CLUSTER_SECRET=

# Host port of the gateway (Explorer, API, MCP).
TVENNDB_PORT=7000

# Image source and version.
TVENNDB_REGISTRY=ghcr.io/hubbiot
TVENNDB_VERSION=1.0.1
